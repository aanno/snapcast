{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch snapclient",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/snapclient",
      "args": ["--player", "pipewire", "tcp://localhost:1704"],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
